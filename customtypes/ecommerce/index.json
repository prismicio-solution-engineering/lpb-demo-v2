{
  "id": "ecommerce",
  "label": "Ecommerce",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "banner": {
              "type": "SharedSlice"
            },
            "product_selection": {
              "type": "SharedSlice"
            },
            "carousel": {
              "type": "SharedSlice"
            },
            "icons": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    },
    "Header": {
      "logo": {
        "type": "Image",
        "config": {
          "label": "Logo",
          "constraint": {},
          "thumbnails": []
        }
      },
      "lnks": {
        "type": "Link",
        "config": {
          "label": "Links",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": true
        }
      }
    },
    "Design": {
      "primary_color": {
        "type": "Color",
        "config": {
          "label": "Primary color",
          "placeholder": ""
        }
      },
      "secondary_color": {
        "type": "Color",
        "config": {
          "label": "Secondary color",
          "placeholder": ""
        }
      },
      "font_heading": {
        "type": "Select",
        "config": {
          "label": "Font - Heading",
          "placeholder": "",
          "default_value": "Function Book",
          "options": [
            "Function Book",
            "Arial Bold",
            "Proxima Bold"
          ]
        }
      },
      "font_txt": {
        "type": "Select",
        "config": {
          "label": "Font - Text",
          "placeholder": "",
          "default_value": "Function Book",
          "options": [
            "Function Book",
            "Helvetica",
            "Inter"
          ]
        }
      },
      "button_style": {
        "type": "Select",
        "config": {
          "label": "Button style",
          "placeholder": "",
          "default_value": "Square",
          "options": [
            "Square",
            "Medium rounded",
            "Rounded"
          ]
        }
      }
    }
  },
  "status": true,
  "format": "page"
}